APP_NAME=VoiceX AI Backend
APP_VERSION=0.1.0
APP_ENV=development
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

OLLAMA_BASE_URL=http://127.0.0.1:11434
