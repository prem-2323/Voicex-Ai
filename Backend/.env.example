APP_NAME=VoiceX AI Backend
APP_VERSION=0.1.0
APP_ENV=development
HOST=127.0.0.1
PORT=8001
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Speech-to-Text (STT) Settings
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Ollama LLM Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# Text-to-Speech (TTS) Settings
TTS_PROVIDER=piper
TTS_FALLBACK_PROVIDER=none
TTS_DEFAULT_VOICE=en-US-AriaNeural
TTS_AUDIO_DIR=generated_audio
TTS_TIMEOUT_SECONDS=60
TTS_RETENTION_SECONDS=3600

# Piper Offline Voice Settings
PIPER_MODELS_DIR=models/piper
PIPER_HINDI_MODEL=hi_IN-pratham-medium
PIPER_ENGLISH_MODEL=en_US-lessac-medium
PIPER_USE_CUDA=false
